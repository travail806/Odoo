<odoo>
	<template id="report_invoice_document_inherit_engagement_marche"
              inherit_id="account.report_invoice_document">

		<xpath expr="//div[@id='informations']" position="inside">
			<div class="col-auto mw-100 mb-2" t-if="o.x_num_order">
				<strong>Numéro d'engagement :</strong>
				<p t-field="o.x_num_order"/>
			</div>
			<div class="col-auto mw-100 mb-2" t-if="o.x_num_marche">
				<strong>Numéro de marché :</strong>
				<p t-field="o.x_num_marche"/>
			</div>
		</xpath>


		<xpath expr="(//address)[1]" position="after">
			<div class="mb-0" t-if="o.commercial_partner_id.x_num_service">
				Numéro de service : <t t-esc="o.commercial_partner_id.x_num_service"/>
			</div>
		</xpath>
		<xpath expr="(//address)[2]" position="after">
			<div class="mb-0" t-if="o.commercial_partner_id.x_num_service">
				Numéro de service : <t t-esc="o.commercial_partner_id.x_num_service"/>
			</div>
		</xpath>
		<xpath expr="(//address)[3]" position="after">
			<div class="mb-0" t-if="o.commercial_partner_id.x_num_service">
				Numéro de service : <t t-esc="o.commercial_partner_id.x_num_service"/>
			</div>
		</xpath>

	</template>
</odoo>